#!name=po0 防火墙自动加白
#!desc=自动将当前出口 IP 加入 po0 防火墙白名单。支持多机器、固定槽位、切网触发与每 10 分钟自动加白，附带原生状态面板。
#!category=po0
#!author=reallinzc, ClaraCora
#!arguments=tokens:""
#!arguments-desc=tokens: po0 防火墙 API token（pgnfw_ 开头），多台机器用英文逗号 , 分隔；token 后加 @槽位可固定位置，例如 pgnfw_xxx@0。请在模块参数填写，不要写入公开仓库。

# 本仓库副本：ClaraCora/ege/surge
# 上游：https://github.com/w0ven/po0fw

[Rule]
# API 必须直连，服务端才能识别本机真实出口。
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-fw-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/ClaraCora/ege/main/surge/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/ClaraCora/ege/main/surge/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/ClaraCora/ege/main/surge/po0-firewall-whitelist.js,timeout=20,argument="tokens={{{tokens}}}"

[Panel]
po0-fw = script-name=po0-fw-panel,title="po0 防火墙 · 等待刷新",content="刷新后显示当前出口与真实白名单",update-interval=300
